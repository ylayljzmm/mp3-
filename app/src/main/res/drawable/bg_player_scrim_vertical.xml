<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页 L2 压暗的竖向渐变（design/05 §5.1）。

  顶 22% → 34% 处完全透明 → 底 55%，用**黑色 alpha** 而不是 surface 色：
  压暗的目的就是「把注意力收到中间」，浅色主题下压黑同样成立；
  用 surface 色在浅色主题下会把上下两端压成白色，反而拉低文字对比。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@android:color/transparent"
        android:centerY="0.34"
        android:endColor="#8C000000"
        android:startColor="#38000000"
        android:type="linear" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面外壳（design/04 §3.5）：左侧抽屉 + 右侧内容列。
  导航完全交给抽屉：首页已经拆掉，它内部的 4 个分区标签成了抽屉条目本身。

  内容列自下而上是「全局页头 64dp → 页面区 → 迷你条」。
  页头是所有二级页共用的一条，页面里不再各自挂标题条。

  注意两点：
  ① DrawerLayout 的 `fitsSystemWindows` 必须是 false —— 沉浸模式由 ImmersiveHelper 打开，
     系统栏 / 刘海的安全区由 `ImmersiveHelper.applyInsets(contentColumn, drawerPanelBody)`
     按真实 window insets 统一处理，**不再写死 dp**（旧版那个 60dp 的
     `car_dock_safe_area` 正是手机被整体抬高 60dp 的元凶，已删除）。
  ② 抽屉面板不用 NavigationView，是「FrameLayout 包一层 LinearLayout」的纯手写结构：
     分组标题、条目、底部三格都由代码填（`DrawerPanelController`）。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <!--
      内容列：全局页头 + 页面区（Fragment 容器）+ 迷你条。
      迷你条放在页面区**下面**而不是叠在上面：叠上去就得给每个页面算底部 padding，
      而迷你条只在二级页出现（播放页隐藏），高度会变，叠着算必然漏。
      底部安全区由 ImmersiveHelper.applyInsets 补在这个容器上，不在这里写死 dp。
    -->
    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          全局页头 64dp：标题 + 左上角「返回 / 菜单」二选一 + 右侧动作位。

          刻意不用 MaterialToolbar：页头要随目的地整体换标题、换返回语义，还会被
          页面内部层级（歌单详情 / 歌手详情 / 文件夹下钻）临时改写副标题与返回箭头。
          启用 Toolbar 自带的 title / menu / NavigationOnClickListener 那一套机制，
          会和页面自己的状态机打架；这里就是三个普通 View，谁来改都由
          `PageHeaderController` 一处决定。

          播放页与主题页整条 GONE：这两页各自带一条完整的顶栏（返回 + 自己的 27sp 标题），
          叠上一层全局页头就等于同一个页面两个标题。这条规则写在
          `PageHeaderController.bind()` 里，布局里不写 visibility。
        -->
        <LinearLayout
            android:id="@+id/pageHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_header_height"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 返回箭头与汉堡键叠在同一格里，尺寸 / 内边距 / 触控区完全一致。
                 方案 H/I 裁定左上角恒为汉堡键：这里默认态即 menu 可见、back 隐藏，
                 PageHeaderController 也只会保持这个状态，避免首帧闪出返回箭头。 -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnPageBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_back"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="?attr/colorOnSurface"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnPageMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu_drawer"
                    android:tint="?attr/colorOnSurface" />
            </FrameLayout>

            <!-- 标题两行：主标题固定 22sp，副标题承载「共 N 首」「歌手名」「歌单名」这类
                 页面内部层级信息；没有副标题时整行 GONE，标题自动垂直居中。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/pageSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右侧动作位：本期没有页面用到，默认 GONE，但结构先留好，
                 后面加「排序 / 搜索 / 多选」不用再动页头。 -->
            <ImageButton
                android:id="@+id/btnPageAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_page_action"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                android:tint="?attr/colorOnSurface"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 页面区：歌曲 / 专辑 / 艺术家 / 文件夹 / 在线 / 电台 / 播客 / 设置 / 关于
             + 播放页 / 主题页全部挂在这里。首页已随分区标签一起删除。 -->
        <FrameLayout
            android:id="@+id/contentHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/miniPlayer"
            layout="@layout/view_mini_player" />
    </LinearLayout>

    <!-- 抽屉面板：左侧贴边直角、右侧 28dp 圆角（背景在 DrawerPanelController 里用
         GradientDrawable 的 cornerRadii 画，才能做到「只有右边两角是圆的」） -->
    <FrameLayout
        android:id="@+id/drawerPanel"
        android:layout_width="@dimen/drawer_width_land"
        android:layout_height="match_parent"
        android:layout_gravity="start">

        <LinearLayout
            android:id="@+id/drawerPanelBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ① 头部 80dp：应用图标 40dp（圆角 12dp）+ 两行文字 -->
            <LinearLayout
                android:id="@+id/drawerHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_header_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/drawerHeaderIcon"
                    android:layout_width="@dimen/drawer_header_icon_size"
                    android:layout_height="@dimen/drawer_header_icon_size"
                    android:background="@drawable/bg_drawer_header_icon"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawerHeaderTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/drawerHeaderSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ② 可滚动的条目区：3 组标题 + 8 条条目由代码填 -->
            <ScrollView
                android:id="@+id/drawerScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:scrollbarSize="4dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/scrollbar_drawer"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/drawerMenuContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <!-- ③ 底部固定三格 80dp：扫描音乐 / 共 N 首 / 主题 -->
            <LinearLayout
                android:id="@+id/drawerBottomBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_bottom_bar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_item_padding_horizontal"
                android:paddingEnd="@dimen/drawer_item_padding_horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/btnDrawerScan"
                        android:layout_width="@dimen/drawer_bottom_pill_width"
                        android:layout_height="@dimen/drawer_bottom_pill_height"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_drawer_pill"
                        android:clickable="true"
                        android:contentDescription="@string/drawer_scan"
                        android:focusable="true"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_drawer_scan"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <TextView
                    android:id="@+id/drawerCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/btnDrawerTheme"
                        android:layout_width="@dimen/drawer_bottom_pill_width"
                        android:layout_height="@dimen/drawer_bottom_pill_height"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_drawer_pill"
                        android:clickable="true"
                        android:contentDescription="@string/drawer_theme"
                        android:focusable="true"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_drawer_theme"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧 1dp 描边；上下各让出圆角半径，避免直线戳出圆角 -->
        <View
            android:id="@+id/drawerEdgeLine"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/drawer_corner_radius"
            android:layout_marginBottom="@dimen/drawer_corner_radius"
            android:background="?attr/colorOutlineVariant" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>

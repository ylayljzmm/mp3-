<?xml version="1.0" encoding="utf-8"?>
<!--
  迷你播放条（design/04 §3.0「迷你条只在二级页出现，64dp」）。

  结构：上边缘 1dp 分隔线 + 48dp 圆角封面 + 两行文字 + 上一曲 / 播放 / 下一曲三键。
  整条（除三个按键）可点 → 回播放页；三键就地控制，不跳页。
  默认 gone：没有正在播放的歌时不留空壳（由 MiniPlayerController 决定显示）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/miniPlayerBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/miniCover"
            android:layout_width="@dimen/mini_player_cover_size"
            android:layout_height="@dimen/mini_player_cover_size"
            android:background="@drawable/bg_mini_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/album_cover"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="17sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniPrev"
            android:layout_width="56dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/miniPlay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/miniNext"
            android:layout_width="56dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    主题设置页的对话框样式。

    刻意单独成文件：`values/themes.xml` 是由 tools/gen_theme_styles.py 整份生成的，
    手写样式放进去会在下次重算色值脚本时被覆盖；放这里则与生成段互不干扰。

    父样式取 Theme.Suisheng.Base，页内所有 ?attr/ 才能解析；
    若用系统 Theme.Material.* 做对话框主题，`?attr/colorSurfaceContainer` 这类
    M3-only attr 会解析失败直接崩溃。
-->
<resources>

    <style name="Theme.Suisheng.FullScreenDialog" parent="Theme.Suisheng.Base">

        <item name="android:windowIsFloating">false</item>

        <item name="android:windowNoTitle">true</item>

        <item name="android:windowCloseOnTouchOutside">false</item>

        <item name="android:windowBackground">?attr/colorSurface</item>

        <item name="android:windowContentOverlay">@null</item>

    </style>

</resources>

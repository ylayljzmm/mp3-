    <string name="more_title">更多</string>
    <string name="more_song_info">歌曲信息</string>
    <string name="more_reload_cover">重新加载专辑封面</string>
    <string name="cover_reload_loading">正在重新加载封面</string>
    <string name="cover_reload_success">封面已更新</string>
    <string name="cover_reload_failed">未能重新加载封面</string>
    <string name="more_info_title">歌曲信息</string>
    <string name="more_info_song">歌曲名：%1$s</string>
    <string name="more_info_artist">歌手：%1$s</string>
    <string name="more_info_album">专辑：%1$s</string>
    <string name="more_info_duration">时长：%1$s</string>
    <string name="more_info_path">文件路径：%1$s</string>
    <string name="more_info_lrc">歌词路径：%1$s</string>

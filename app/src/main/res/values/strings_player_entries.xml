<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页「队列 / 收藏 / 更多」三个入口的文案（期 4）。

  刻意单独成文件：res/values/strings.xml 里已有 player_queue / player_action_favorite 等
  同义文案，改它容易和并行改动冲突，所以本期新增文案全部放这里。
  重名会直接编译失败，所以下面每个 name 都先 grep 过 strings.xml / strings_library.xml。
-->
<resources>

    <!-- 队列面板 -->
    <string name="queue_title">播放队列</string>
    <string name="queue_count">共 %1$d 首</string>
    <!-- 列表里已有 ♪ 与高亮标出当前项，头部不必再写完整一句。 -->
    <string name="queue_count_current">共 %1$d 首 · 第 %2$d 首</string>
    <string name="queue_clear">清空</string>
    <string name="queue_clear_confirm">清空后当前播放也会停止，确定要清空播放队列吗？</string>
    <string name="queue_empty">播放队列是空的</string>
    <string name="queue_remove">移出队列</string>
    <string name="queue_cleared">已清空队列</string>

    <!-- 移出后的两步操作条（撤销 / 删除文件） -->
    <string name="queue_removed_hint">已移出 %1$s</string>
    <string name="queue_undo">撤销</string>
    <string name="queue_delete_files">删除文件</string>
    <string name="queue_delete_files_title">删除本地文件</string>
    <string name="queue_delete_files_message_audio">音频：%1$s</string>
    <string name="queue_delete_files_message_lyrics">歌词（%1$d 个）：\n%2$s</string>
    <string name="queue_delete_files_also_lyrics">同时删除歌词文件</string>
    <string name="queue_delete_files_no_lyric">这首歌没有歌词文件</string>
    <string name="queue_delete_files_done">已删除</string>
    <string name="queue_delete_files_failed">删除失败，文件被占用或不可写</string>

    <!-- 歌词来源选择（播放页「调」→「来源」页；文案与队列无关，放这里是为了不和并行改动冲突） -->
    <string name="lyric_source_auto">自动（按顺序尝试）</string>

    <!-- 收藏 -->
    <string name="favorite_add">收藏</string>
    <string name="favorite_remove">取消收藏</string>
    <string name="favorite_added">已收藏</string>
    <string name="favorite_removed">已取消收藏</string>


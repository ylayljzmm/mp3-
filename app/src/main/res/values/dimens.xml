<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 车机系统 Dock 安全区：把内容区与抽屉面板底部抬到系统 Dock 之上，
         适配 2021 款宋 PLUS DM-i（DiLink 3.0）默认横屏。改这一处即可全局微调。 -->
    <dimen name="car_dock_safe_area">60dp</dimen>

    <!-- =========================================================
         主题系统 token（design/04 §2.8、§3.7）
         ========================================================= -->
    <!-- 圆形色卡直径 -->
    <dimen name="theme_swatch_size">64dp</dimen>
    <!-- 选中环宽与环-卡之间的空隙 -->
    <dimen name="theme_swatch_ring_width">2dp</dimen>
    <dimen name="theme_swatch_ring_gap">4dp</dimen>
    <!-- 色卡网格单元（横屏 5 列 × 2 行） -->
    <!-- 明暗 4 档分段控件高度 -->
    <dimen name="theme_mode_toggle_height">56dp</dimen>

    <!-- =========================================================
         抽屉 token（design/04 §3.5，期 2c 使用）
         ========================================================= -->
    <!-- 横屏面板宽 400dp；竖屏 300dp -->
    <dimen name="drawer_width_land">400dp</dimen>
    <dimen name="drawer_width_port">300dp</dimen>
    <!-- 面板右上/右下圆角；左侧贴边直角 -->
    <dimen name="drawer_corner_radius">28dp</dimen>
    <!-- 头部 80dp：应用图标 40dp + 两行文字 -->
    <dimen name="drawer_header_height">80dp</dimen>
    <dimen name="drawer_header_icon_size">40dp</dimen>
    <dimen name="drawer_header_icon_corner">12dp</dimen>
    <!-- 分组标题 28dp；条目 60dp（≥ 60dp 触控下限） -->
    <dimen name="drawer_group_title_height">28dp</dimen>
    <dimen name="drawer_item_height">60dp</dimen>
    <!-- 面板左右内边距；文字区起点距面板左 56dp = 16 + 24 + 16 -->
    <dimen name="drawer_item_padding_horizontal">16dp</dimen>
    <dimen name="drawer_item_text_start">56dp</dimen>
    <dimen name="drawer_item_icon_size">24dp</dimen>
    <!-- 选中态四周内缩 8dp（→ 352×44dp） -->
    <dimen name="drawer_item_inset">8dp</dimen>
    <!-- 底部固定三格 80dp -->
    <dimen name="drawer_bottom_bar_height">80dp</dimen>
    <dimen name="drawer_bottom_pill_width">60dp</dimen>
    <dimen name="drawer_bottom_pill_height">44dp</dimen>

    <!-- =========================================================
         迷你条（design/04 §3.0：只在二级页出现，64dp）
         ========================================================= -->
    <dimen name="mini_player_height">64dp</dimen>
    <dimen name="mini_player_cover_size">48dp</dimen>
    <!-- 圆角 = 边长 × 7.5%（§2.8） -->
    <dimen name="mini_player_cover_corner">8dp</dimen>

    <!-- =========================================================
         分组页（专辑 / 艺术家 / 文件夹）
         ========================================================= -->
    <dimen name="library_top_bar_height">56dp</dimen>
    <dimen name="library_page_margin_horizontal">32dp</dimen>
    <dimen name="library_row_height">72dp</dimen>
    <dimen name="library_avatar_size">40dp</dimen>
    <dimen name="library_card_corner">14dp</dimen>

    <!-- =========================================================
         设置页 token（design/04 §3.6）
         ========================================================= -->
    <dimen name="settings_page_margin_horizontal">32dp</dimen>
    <dimen name="settings_group_spacing">24dp</dimen>
    <dimen name="settings_group_title_height">32dp</dimen>
    <dimen name="settings_group_corner_radius">16dp</dimen>

    <!-- =========================================================
         播放页中轴（design/05 §3.1，方案 D）—— 三档按屏高分

         | 档位 | 适用 | 可用高度 | 该档总高 |
         | 本文件（默认） | 屏高 < 600dp | 540 − 64 − 48 = 428 | 419 |
         | values-h600dp | 600 ~ 719dp | 600 − 64 − 48 = 488 | 478 |
         | values-h720dp | ≥ 720dp | 720 − 64 − 48 = 608 | 583 |

         为什么必须分档：§10 验收第 2 条要求「根布局 canScrollVertically 恒为 false」，
         而 §3.1 的 292dp 中轴 + 64dp 顶栏在 600dp 高的屏上物理溢出 47dp，两条自相矛盾。
         只能按屏高给不同尺度的同一批名字，不能靠滚动或百分比缩放解决。

         默认档必须按 **540dp** 算而不是按 600dp：1920×1080 的面板若按 320dpi 上报
         （车机很常见），dp 高度就是 540，此时 `-h600dp` 不匹配，会落进这一档。

         三档都**不动歌名 42dp / 歌手 20dp 行高**：用户要的是大字，宁可缩唱片也不缩字。
         ========================================================= -->
    <dimen name="player_axis_width">300dp</dimen>
    <dimen name="player_axis_offset">8dp</dimen>
    <dimen name="player_topbar">64dp</dimen>
    <!-- 196 + 16 + 42 + 4 + 20 + 10 + 10 + 8 + 58 + 5 + 50 = 419 ≤ 428 ✓ -->
    <dimen name="vinyl_size">196dp</dimen>
    <dimen name="vinyl_art">130dp</dimen>
    <dimen name="player_gap_vinyl_title">16dp</dimen>
    <dimen name="player_gap_title_artist">4dp</dimen>
    <dimen name="player_gap_artist_progress">10dp</dimen>
    <dimen name="player_gap_progress_transport">8dp</dimen>
    <dimen name="player_gap_transport_actions">5dp</dimen>
    <dimen name="player_transport_size">58dp</dimen>
    <dimen name="player_transport_btn">52dp</dimen>
    <dimen name="player_action_row_height">50dp</dimen>
    <dimen name="player_action_cell_width">64dp</dimen>
    <dimen name="player_time_width">38dp</dimen>
    <dimen name="player_progress_height">10dp</dimen>
    <dimen name="player_vinyl_hole">12dp</dimen>
    <dimen name="player_topbar_button">60dp</dimen>
    <dimen name="player_topbar_padding">12dp</dimen>
    <dimen name="player_lyrics_padding_start">16dp</dimen>
    <dimen name="player_lyrics_padding_end">64dp</dimen>

    <!-- 主键内边距：保证图标恒为 (按钮 − 2×padding) ≈ 34dp（§3.3「图标 34dp」）。
         78dp 档 22dp、58dp 档 12dp。 -->
    <dimen name="player_transport_padding">12dp</dimen>

    <!-- 进度条滑块半径：静止 6.5dp（直径 13dp），拖动中 8dp（直径 16dp）（§3.2）。 -->
    <dimen name="player_slider_thumb_radius">6.5dp</dimen>
    <dimen name="player_slider_thumb_radius_active">8dp</dimen>
</resources>

<?xml version="1.0" encoding="utf-8"?>

<resources>
<!-- ===== 随声主题（自动生成段开始）  深色 · 请勿手工编辑 ===== -->

    <!-- 底座：Theme.Material3.Dark.NoActionBar -->
    <style name="Theme.Suisheng.Base" parent="Theme.Material3.Dark.NoActionBar">

        <!-- 8 个组件默认 style（切换主题后全局生效，无需手写 tint） -->
        <item name="materialButtonStyle">@style/Widget.Suisheng.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Suisheng.CardView</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Suisheng.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Suisheng.AlertDialog</item>
        <item name="sliderStyle">@style/Widget.Suisheng.Slider</item>
        <item name="chipStyle">@style/Widget.Suisheng.Chip</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.Suisheng.ButtonToggleGroup</item>
        <item name="materialSwitchStyle">@style/Widget.Suisheng.Switch</item>

        <!-- 系统栏与窗口底色：全部走 attr，切主题自动跟随 -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans</item>

    </style>

    <style name="Widget.Suisheng.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.Suisheng.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.Suisheng.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">13dp</item>
    </style>

    <style name="Widget.Suisheng.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">15sp</item>
        <item name="chipCornerRadius">18dp</item>
    </style>

    <style name="Widget.Suisheng.ButtonToggleGroup" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.Suisheng.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ThemeOverlay.Suisheng.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet.Modal</item>
    </style>

    <style name="ThemeOverlay.Suisheng.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
    </style>


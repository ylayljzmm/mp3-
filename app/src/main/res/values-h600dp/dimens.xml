<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页中轴 · 中间档（600 ~ 719dp 屏高）。

  可用高度 = 600 − 64（顶栏）− 48（上下各 24 安全边距）= 488dp
  该档总高 = 231 + 14 + 42 + 4 + 20 + 10 + 26 + 8 + 66 + 5 + 52 = 478dp ≤ 488 ✓（余量 10）

  典型的 1024×600 车机（密度 1.0 → 600dp）落这一档。
  只覆盖受屏高约束的尺寸；轴宽 300、时间 46、带高 26 等由本文件显式覆盖，
  未写的 key（主键 52、滑块半径等）回落到 `values-h480dp/dimens.xml`。

  5.5.0 车机整改（四档同改）：功能行文字标签全删 → 行高 58 → 52；省出的高度进进度带
  （10 → 26）；时间宽 38 → 46；功能行图标 22 → 30；唱片 236 → 231。
-->
<resources>
    <!-- 231 + 14 + 42 + 4 + 20 + 10 + 26 + 8 + 66 + 5 + 52 = 478 ≤ 488 ✓ -->
    <dimen name="vinyl_size">231dp</dimen>
    <!-- 封面直径 = 唱片 × 0.70（§4.1 L4）：231 × 0.70 ≈ 162 -->
    <dimen name="vinyl_art">162dp</dimen>
    <dimen name="player_gap_vinyl_title">14dp</dimen>
    <dimen name="player_gap_title_artist">4dp</dimen>
    <dimen name="player_gap_artist_progress">10dp</dimen>
    <dimen name="player_gap_progress_transport">8dp</dimen>
    <dimen name="player_gap_transport_actions">5dp</dimen>
    <dimen name="player_transport_size">66dp</dimen>
    <dimen name="player_action_row_height">52dp</dimen>
    <dimen name="player_time_width">46dp</dimen>
    <dimen name="player_progress_height">26dp</dimen>
    <!-- 主键图标恒为 (66 − 2×16) = 34dp（§3.3） -->
    <dimen name="player_transport_padding">16dp</dimen>

    <!-- 字号 / 功能行图标：歌名 35sp、歌手 16sp 保持不变（用户要大字），
         功能行图标 5.5.0 由 22dp 放大到 30dp。 -->
    <dimen name="player_title_text_size">35sp</dimen>
    <dimen name="player_artist_text_size">16sp</dimen>
    <dimen name="player_action_icon_size">30dp</dimen>

    <!-- 5.6.0 手机档顶栏：h480dp 那里是车机的 64dp / 60dp / 12dp，手机竖屏
         （约 780dp 高）落 h720dp，屏高 600~719dp 的大屏手机落本档。
         手机没有车机那么宽的 Dock 边距，顶栏用 56dp 就够，按键回到 48dp
         的 Material 最小触控区。 -->
    <dimen name="player_topbar">56dp</dimen>
    <dimen name="player_topbar_button">48dp</dimen>
    <dimen name="player_topbar_padding">8dp</dimen>
    <dimen name="player_topbar_button_padding">12dp</dimen>
    <dimen name="player_lyrics_padding_start">8dp</dimen>
</resources>

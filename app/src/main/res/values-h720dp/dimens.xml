<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页中轴：720dp 及以上屏高用 design/05 §3.1 的文档原值。

  中轴各段 = 296 + 22 + 42（歌名行高）+ 4 + 20（歌手行高）+ 18 + 28（进度带）+ 12 + 78 + 7 + 56
           = 583dp
  720dp 画布减顶栏 64、上下各 24 安全边距 → 可用 608dp，余量 25dp，不滚动。

  5.5.0 车机整改（四档同改）：功能行文字标签全删 → 行高 68 → 56；省出的高度进进度带
  （10 → 28）；时间宽 38 → 46；功能行图标 22 → 32；两个竖向间距各减 2dp / 1dp。

  只覆盖受屏高约束的那几个尺寸；轴宽 300、主键 52、滑块半径等回落到 `values-h480dp/dimens.xml`。
-->
<resources>
    <dimen name="vinyl_size">296dp</dimen>
    <!-- 封面直径 = 唱片 × 0.70（§4.1 L4），296 × 0.70 ≈ 207 -->
    <dimen name="vinyl_art">207dp</dimen>
    <dimen name="player_gap_vinyl_title">22dp</dimen>
    <dimen name="player_gap_title_artist">4dp</dimen>
    <dimen name="player_gap_artist_progress">18dp</dimen>
    <dimen name="player_gap_progress_transport">12dp</dimen>
    <dimen name="player_gap_transport_actions">7dp</dimen>
    <dimen name="player_transport_size">78dp</dimen>
    <dimen name="player_action_row_height">56dp</dimen>
    <dimen name="player_time_width">46dp</dimen>
    <dimen name="player_progress_height">28dp</dimen>
    <!-- 主键图标恒为 (78 − 2×22) = 34dp（§3.3） -->
    <dimen name="player_transport_padding">22dp</dimen>

    <!-- 字号 / 功能行图标：歌名 35sp、歌手 16sp 保持不变（用户要大字），
         功能行图标 5.5.0 由 22dp 放大到 32dp。 -->
    <dimen name="player_title_text_size">35sp</dimen>
    <dimen name="player_artist_text_size">16sp</dimen>
    <dimen name="player_action_icon_size">32dp</dimen>

    <!-- 5.6.0 手机档顶栏（与 h600dp 同值）：手机竖屏是这一档的主要使用者。
         车机档（≤ 599dp 屏高）仍是 64dp / 60dp / 12dp，不动。 -->
    <dimen name="player_topbar">56dp</dimen>
    <dimen name="player_topbar_button">48dp</dimen>
    <dimen name="player_topbar_padding">8dp</dimen>
    <dimen name="player_topbar_button_padding">12dp</dimen>
    <dimen name="player_lyrics_padding_start">8dp</dimen>
</resources>
